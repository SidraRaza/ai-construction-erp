generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id               String   @id @default(cuid())
  name             String
  logoUrl          String?
  address          String?
  country          String?  @default("Pakistan")
  taxNumber        String?
  bankDetails      String?
  subscriptionPlan String   @default("FREE")
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())

  users            User[]
  projects         Project[]
  clients          Client[]
  customFields     CustomField[]
  customEntries    CustomFieldEntry[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String?
  role         String   // SUPER_ADMIN | ADMIN | ENGINEER | LABOUR | CLIENT
  status       String   @default("ACTIVE")
  avatarUrl    String?
  createdAt    DateTime @default(now())

  projectTeams ProjectTeam[]
}

model Project {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name         String
  startDate    DateTime
  endDate      DateTime?
  budget       Decimal
  status       String        @default("PLANNED") // PLANNED | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED
  priority     String        @default("MEDIUM")
  progressPct  Int           @default(0)
  createdAt    DateTime      @default(now())

  team         ProjectTeam[]
  expenses     Expense[]
  quotations   Quotation[]
  invoices     Invoice[]
}

model ProjectTeam {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // SITE_ENGINEER | MASON_LEAD | FOREMAN | WORKER
  assignedAt DateTime @default(now())
}

model Client {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  contact   String
  email     String
  createdAt DateTime @default(now())

  projects   Project[]
  quotations Quotation[]
}

model Material {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  unit         String   // BAGS | TONS | KG | PIECES | CUBIC_METERS
  stockQty     Decimal  @default(0)
  reorderLevel Decimal  @default(10)
  createdAt    DateTime @default(now())

  inventories Inventory[]
}

model Inventory {
  id          String   @id @default(cuid())
  materialId  String
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type        String   // IN | OUT
  qty         Decimal
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receivedAt  DateTime @default(now())
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  contact   String
  category  String   // CEMENT | STEEL | AGGREGATES | ELECTRICAL | PLUMBING
  rating    Decimal? @default(5.0)
  createdAt DateTime @default(now())

  inventories Inventory[]
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String   // MATERIALS | LABOUR | EQUIPMENT | PERMITS | OVERHEAD
  amount      Decimal
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model Attendance {
  id        String   @id @default(cuid())
  workerId  String
  date      DateTime
  status    String   // PRESENT | LATE | ABSENT | HALF_DAY
  createdAt DateTime @default(now())
}

model Quotation {
  id          String    @id @default(cuid())
  companyId   String
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items       String    // JSON string array of items
  gstPct      Decimal   @default(17)
  discount    Decimal   @default(0)
  notes       String?
  status      String    @default("DRAFT") // DRAFT | SENT | APPROVED | REJECTED
  version     Int       @default(1)
  createdAt   DateTime  @default(now())

  invoices    Invoice[]
}

model Invoice {
  id          String    @id @default(cuid())
  companyId   String
  clientId    String
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  amount      Decimal
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING | PAID | OVERDUE | VOIDED
  version     Int       @default(1)
  createdAt   DateTime  @default(now())

  payments    Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal
  method    String
  reference String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  companyId  String
  userId     String
  action     String
  entityType String
  entityId   String?
  meta       String?  // JSON string
  createdAt  DateTime @default(now())
}

model CustomField {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fieldName   String   // Display label
  fieldType   String   // TEXT | NUMBER | DATE | SELECT | CHECKBOX
  options     String?  // JSON string array for select dropdown options
  isRequired  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomFieldEntry {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recordTitle String   // Title of custom production record e.g. "Concrete Pouring Log #101"
  fieldValues String   // JSON string of custom key-value pairs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
